+    @Test void moduleMissesReexportChangesAndBatchMovesAreTracked() throws Exception {
+        write("main.js","import {go} from './barrel.js'; go();");
+        write("barrel.js","export {first as go} from './missing.js';");
+        write("other.js","export function untouched(){}");
+        try(var storage=new GraphStorage(true,32L<<20)) {
+            var graph=storage.create();var indexer=indexer(graph);indexer.fullIndex();assertFreshParity(graph);
+            write("missing.js","export function first(){} export function second(){}");
+            indexer.applyChanges(List.of("missing.js"));assertFreshParity(graph);
+            assertTrue(indexer.lastHybridUpdate().resolvedFiles()<4);
+            write("barrel.js","export {second as go} from './missing.js';");
+            indexer.applyChanges(List.of("barrel.js"));assertFreshParity(graph);
+            assertEquals(2,indexer.lastHybridUpdate().resolvedFiles());
+            Files.move(root.resolve("missing.js"),root.resolve("moved.js"));
+            write("barrel.js","export {second as go} from './moved.js';");
+            indexer.applyChanges(List.of("missing.js","moved.js","barrel.js"));assertFreshParity(graph);
+        }
+    }
