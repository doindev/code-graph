+    @Test void isolatedDeclarationDoesNotResolveUnrelatedFiles() throws Exception {
+        write("Probe.java","class Probe { static void oldName(){} }");
+        for(int n=0;n<40;n++)write("Unrelated"+n+".java","class Unrelated"+n+" { void own(){ own(); } }");
+        try(var storage=new GraphStorage(true,32L<<20)) {
+            var graph=storage.create();var indexer=indexer(graph);indexer.fullIndex();
+            write("Probe.java","class Probe { static void newName(){} }");
+            indexer.applyChanges(List.of("Probe.java"));
+            assertEquals("incremental-targeted",indexer.lastHybridUpdate().mode());
+            assertEquals(1,indexer.lastHybridUpdate().resolvedFiles());assertFreshParity(graph);
+            var queued=new AtomicInteger();((PagedGraph)graph).documents("resolution/affected/",(k,v)->queued.incrementAndGet());
+            assertEquals(0,queued.get(),"transient work queue must be removed before publication");
+        }
+    }
+
+    @Test void negativeLookupsAndNewOverloadsHealWithoutGlobalReresolution() throws Exception {
+        write("Use.java","class Use { void run(){ Api.consume(\"hello\"); Missing.go(); } }");
+        write("Api.java","class Api { static void consume(Object x){} }");
+        write("Other.java","class Other { void own(){ own(); } }");
+        try(var storage=new GraphStorage(true,32L<<20)) {
+            var graph=storage.create();var indexer=indexer(graph);indexer.fullIndex();assertFreshParity(graph);
+            write("Api.java","class Api { static void consume(Object x){} static void consume(String x){} }");
+            indexer.applyChanges(List.of("Api.java"));
+            assertEquals(2,indexer.lastHybridUpdate().resolvedFiles());assertFreshParity(graph);
+            write("Missing.java","class Missing { static void go(){} }");
+            indexer.applyChanges(List.of("Missing.java"));
+            assertEquals(2,indexer.lastHybridUpdate().resolvedFiles());assertFreshParity(graph);
+            Files.delete(root.resolve("Missing.java"));indexer.applyChanges(List.of("Missing.java"));
+            assertEquals(1,indexer.lastHybridUpdate().resolvedFiles());assertFreshParity(graph);
+        }
+    }
+
+    @Test void hierarchyOverridesAndReturnTypeChainsInvalidateTheirLookupReaders() throws Exception {
+        write("Base.java","class Base { void go(){} }");
+        write("Child.java","class Child extends Base {}");
+        write("Alternate.java","class Alternate { void go(){} }");
+        write("Factory.java","class Factory { static Child make(){ return null; } }");
+        write("Use.java","class Use { void run(){ Factory.make().go(); } }");
+        write("Unrelated.java","class Unrelated {}");
+        try(var storage=new GraphStorage(true,32L<<20)) {
+            var graph=storage.create();var indexer=indexer(graph);indexer.fullIndex();assertFreshParity(graph);
+            write("Child.java","class Child extends Base { @Override void go(){} }");
+            indexer.applyChanges(List.of("Child.java"));assertFreshParity(graph);
+            assertTrue(indexer.lastHybridUpdate().resolvedFiles()<6);
+            write("Factory.java","class Factory { static Alternate make(){ return null; } }");
+            indexer.applyChanges(List.of("Factory.java"));assertFreshParity(graph);
+            assertTrue(indexer.lastHybridUpdate().resolvedFiles()<6);
+            write("Child.java","class Child extends Alternate {}");
+            indexer.applyChanges(List.of("Child.java"));assertFreshParity(graph);
+        }
+    }
