+    @Test void genericNameAmbiguityAndRemovalInvalidatePositiveAndNegativeLookups() throws Exception {
+        write("main.py","def caller():\n    work()\n    future()\n");
+        write("one.py","def work():\n    pass\n");
+        write("other.py","def independent():\n    pass\n");
+        try(var storage=new GraphStorage(true,32L<<20)) {
+            var graph=storage.create();var indexer=indexer(graph);indexer.fullIndex();assertFreshParity(graph);
+            write("two.py","def work():\n    pass\ndef future():\n    pass\n");
+            indexer.applyChanges(List.of("two.py"));assertFreshParity(graph);
+            assertEquals(2,indexer.lastHybridUpdate().resolvedFiles());
+            Files.delete(root.resolve("one.py"));indexer.applyChanges(List.of("one.py"));assertFreshParity(graph);
+        }
+    }
