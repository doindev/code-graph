+        /**
+         * Visit the mutable staged head in key order without retaining a cursor
+         * across callbacks. Use when callbacks write heavily but do not need a
+         * snapshot of the scanned prefix (e.g. resolving unchanged fragments).
+         * Added keys after the last visited key may be visited; removed keys are
+         * skipped. Ordinary scanAuxiliary retains its stable-root semantics.
+         */
+        public void scanAuxiliaryCurrent(String prefix, BiConsumer<String, byte[]> visitor) {
+            checkOpen();
+            String fullPrefix = "a/" + prefix;
+            String key = generation.writerMap.ceilingKey(fullPrefix);
+            while (key != null && key.startsWith(fullPrefix)) {
+                checkOpen();
+                byte[] value = generation.writerMap.get(key);
+                visitor.accept(key, value);
+                // No old cursor/page/version survives a callback's commits.
+                key = generation.writerMap.higherKey(key);
+            }
+        }
     }
 
