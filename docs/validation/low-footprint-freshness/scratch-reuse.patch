+++ b/code-graph-index/src/test/java/io/doindev/codegraph/index/HybridSymbolLookupTest.java
@@ -0,0 +1,55 @@
+package io.doindev.codegraph.index;
+
+import io.doindev.codegraph.model.*;
+import io.doindev.codegraph.storage.*;
+import io.doindev.codegraph.parse.ResolutionLanguages;
+import java.util.*;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HybridSymbolLookupTest {
+    private static Node node(String name,String signature) {
+        return new Node(new SymbolId("java","Api.java","Api."+name,0),NodeKind.FUNCTION,name,signature,
+                new SourceSpan("Api.java",1,1,1,10),Metrics.NONE,Map.of("signature",signature));
+    }
+    private static void put(PagedGraph.Builder builder,Node node) {
+        builder.auxiliary("simple/"+PagedGraph.encodeKey(ResolutionLanguages.family("java"))+"/"+PagedGraph.encodeKey(node.name())+"/one",RecordCodec.node(node));
+    }
+    @Test void filesShareOneBoundedScratchButLaterPhasesNeverReuseIt() {
+        try(var storage=new GraphStorage(true,32L<<20)) {
+            var graph=(PagedGraph)storage.create();
+            graph.rebuild(builder->{
+                put(builder,node("go","void go()"));
+                var first=new HybridSymbolLookup(builder,"A.java");var second=first.forSource("B.java");
+                var list=first.bySimpleName("go","java");
+                assertEquals(1,list.size());
+                assertSame(list,second.bySimpleName("go","java"));
+                assertThrows(UnsupportedOperationException.class,()->list.clear());
+                for(int n=0;n<256;n++)second.bySimpleName("missing"+n,"java");
+                assertNotSame(list,first.bySimpleName("go","java"),"entry budget is shared, not per file");
+                assertTrue(second.bySimpleName("future","java").isEmpty());
+                // A new resolution phase must be built after declaration writes.
+                put(builder,node("future","int future()"));
+                var next=new HybridSymbolLookup(builder,"C.java");
+                assertEquals(1,next.bySimpleName("future","java").size());
+                return null;
+            });
+            graph.update(builder->{
+                put(builder,node("go","String go()"));
+                assertEquals("String go()",new HybridSymbolLookup(builder,"A.java").bySimpleName("go","java").getFirst().attrs().get("signature"));
+                return null;
+            });
+        }
+    }
+    @Test void oversizedLookupIsNotRetainedAcrossFiles() {
+        try(var storage=new GraphStorage(true,32L<<20)) {
+            var graph=(PagedGraph)storage.create();
+            graph.rebuild(builder->{
+                put(builder,node("large","x".repeat(2*1024*1024)));
+                var first=new HybridSymbolLookup(builder,"A.java");var second=first.forSource("B.java");
+                assertNotSame(first.bySimpleName("large","java"),second.bySimpleName("large","java"));
+                return null;
+            });
+        }
+    }
+}
