<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.doindev</groupId>
    <artifactId>code-graph</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>code-graph-cli</artifactId>
  <name>code-graph-cli</name>
  <description>Headless CI runner: index, diff-scoped blast/drift/smell reports, GitHub/GitLab posting, gating exit codes</description>

  <dependencies>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-index</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-java</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-javascript</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-python</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-go</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-rust</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-c</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-csharp</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-php</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-ruby</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-kotlin</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-scala</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-swift</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-dart</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-objc</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.doindev</groupId>
      <artifactId>code-graph-lang-sql</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>code-graph</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.doindev.codegraph.cli.Main</mainClass>
                </transformer>
                <!-- the ten lang jars each ship a LanguageAnalyzer service file; these MUST merge -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
