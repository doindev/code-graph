<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.doindev</groupId>
    <artifactId>code-graph</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>code-graph-mcp</artifactId>
  <name>code-graph-mcp</name>
  <description>stdio MCP server exposing the code-graph tool set (official MCP Java SDK, quarantined to this module)</description>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>code-graph-build.properties</include></includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>code-graph-build.properties</exclude></excludes>
      </resource>
    </resources>
  </build>
